{
  "server": {
    "proxy_port": 8080,
    "admin_grpc_port": 50051
  },
  "load_balancing": {
    "strategy": "least-connections"
  },
  "backends": [
    { "id": "frontend-1", "url": "env:FRONTEND_1_URL", "weight": 1, "enabled": true },
    { "id": "frontend-2", "url": "env:FRONTEND_2_URL", "weight": 1, "enabled": true },
    { "id": "users-1", "url": "env:USERS_1_URL", "weight": 2, "enabled": true },
    { "id": "users-2", "url": "env:USERS_2_URL", "weight": 2, "enabled": true },
    { "id": "orders-1", "url": "env:ORDERS_1_URL", "weight": 2, "enabled": true },
    { "id": "orders-2", "url": "env:ORDERS_2_URL", "weight": 2, "enabled": true },
    { "id": "payments-1", "url": "env:PAYMENTS_1_URL", "weight": 1, "enabled": true },
    { "id": "payments-2", "url": "env:PAYMENTS_2_URL", "weight": 1, "enabled": true }
  ],
  "health_check": {
    "path": "/health",
    "interval_seconds": 2,
    "timeout_seconds": 1,
    "healthy_threshold": 1,
    "success_codes": [200]
  },
  "timeouts": {
    "connect_timeout_ms": 5000,
    "response_timeout_ms": 30000,
    "keep_alive_timeout_ms": 30000,
    "idle_conn_timeout_ms": 90000
  },
  "security": {
    "policies": [
      {
        "id": "shop-public",
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 120,
          "burst": 40,
          "window_sec": 60
        }
      }
    ]
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "async": true,
    "buffer_size": 65536
  },
  "virtual_hosts": [
    {
      "domain": "shop.example.local",
      "backend_ids": ["frontend-1", "frontend-2"],
      "security_policy_id": "shop-public",
      "path_routes": [
        {
          "path": "/api/users",
          "backend_ids": ["users-1", "users-2"],
          "strip_prefix": false
        },
        {
          "path": "/api/orders",
          "backend_ids": ["orders-1", "orders-2"],
          "strip_prefix": false
        },
        {
          "path": "/api/payments",
          "backend_ids": ["payments-1", "payments-2"],
          "strip_prefix": false
        }
      ]
    }
  ]
}
