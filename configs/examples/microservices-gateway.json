{
  "proxy_port": 8080,
  "lb_strategy": "least-connections",
  "backends": [
    { "url": "env:FRONTEND_1_URL", "weight": 1, "enabled": true },
    { "url": "env:FRONTEND_2_URL", "weight": 1, "enabled": true },
    { "url": "env:USERS_1_URL", "weight": 2, "enabled": true },
    { "url": "env:USERS_2_URL", "weight": 2, "enabled": true },
    { "url": "env:ORDERS_1_URL", "weight": 2, "enabled": true },
    { "url": "env:ORDERS_2_URL", "weight": 2, "enabled": true },
    { "url": "env:PAYMENTS_1_URL", "weight": 1, "enabled": true },
    { "url": "env:PAYMENTS_2_URL", "weight": 1, "enabled": true }
  ],
  "health_check": {
    "path": "/health",
    "interval_seconds": 2,
    "timeout_seconds": 1,
    "healthy_threshold": 1,
    "success_codes": [200]
  },
  "timeouts": {
    "connect_timeout_ms": 5000,
    "response_timeout_ms": 30000,
    "keep_alive_timeout_ms": 30000,
    "idle_conn_timeout_ms": 90000
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "async": true,
    "buffer_size": 65536
  },
  "virtual_hosts": [
    {
      "domain": "shop.example.local",
      "backends": ["env:FRONTEND_1_URL", "env:FRONTEND_2_URL"],
      "path_routes": [
        {
          "path": "/api/users",
          "backends": ["env:USERS_1_URL", "env:USERS_2_URL"],
          "strip_prefix": false
        },
        {
          "path": "/api/orders",
          "backends": ["env:ORDERS_1_URL", "env:ORDERS_2_URL"],
          "strip_prefix": false
        },
        {
          "path": "/api/payments",
          "backends": ["env:PAYMENTS_1_URL", "env:PAYMENTS_2_URL"],
          "strip_prefix": false
        }
      ],
      "security": {
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 120,
          "burst": 40,
          "window_sec": 60
        }
      }
    }
  ]
}
