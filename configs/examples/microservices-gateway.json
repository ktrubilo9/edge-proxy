{
  "server": {
    "proxy_port": 8080,
    "admin_grpc_port": 50051
  },
  "load_balancing": {
    "strategy": "least-connections"
  },
  "backends": [
    { "id": "frontend-1", "url": "http://frontend-1:8080", "weight": 1, "enabled": true },
    { "id": "frontend-2", "url": "http://frontend-2:8080", "weight": 1, "enabled": true },
    { "id": "users-1", "url": "http://users-1:8080", "weight": 2, "enabled": true },
    { "id": "users-2", "url": "http://users-2:8080", "weight": 2, "enabled": true },
    { "id": "orders-1", "url": "http://orders-1:8080", "weight": 2, "enabled": true },
    { "id": "orders-2", "url": "http://orders-2:8080", "weight": 2, "enabled": true },
    { "id": "payments-1", "url": "http://payments-1:8080", "weight": 1, "enabled": true },
    { "id": "payments-2", "url": "http://payments-2:8080", "weight": 1, "enabled": true }
  ],
  "health_check": {
    "enabled": true,
    "probe": {
      "type": "http",
      "path": "/health",
      "method": "GET",
      "timeout_ms": 1000,
      "success_codes": [200]
    },
    "schedule": {
      "interval_ms": 2000,
      "jitter_ms": 300
    },
    "concurrency": {
      "workers": 8,
      "queue_size": 32
    },
    "thresholds": {
      "healthy": 1,
      "unhealthy": 3
    },
    "recovery": {
      "backoff": {
        "enabled": true,
        "initial_ms": 5000,
        "max_ms": 30000,
        "multiplier": 2.0
      }
    },
    "transport": {
      "max_idle_conns": 100,
      "max_idle_conns_per_host": 4,
      "max_conns_per_host": 16,
      "keep_alive_ms": 30000
    },
    "passive": {
      "enabled": true
    }
  },
  "timeouts": {
    "connect_timeout_ms": 5000,
    "response_timeout_ms": 30000,
    "keep_alive_timeout_ms": 30000,
    "idle_conn_timeout_ms": 90000
  },
  "security": {
    "policies": [
      {
        "id": "shop-public",
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 120,
          "burst": 40,
          "window_sec": 60
        }
      }
    ]
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "async": true,
    "buffer_size": 65536
  },
  "virtual_hosts": [
    {
      "domain": "shop.example.local",
      "backend_ids": ["frontend-1", "frontend-2"],
      "security_policy_id": "shop-public",
      "path_routes": [
        {
          "path": "/api/users",
          "backend_ids": ["users-1", "users-2"],
          "strip_prefix": false
        },
        {
          "path": "/api/orders",
          "backend_ids": ["orders-1", "orders-2"],
          "strip_prefix": false
        },
        {
          "path": "/api/payments",
          "backend_ids": ["payments-1", "payments-2"],
          "strip_prefix": false
        }
      ]
    }
  ]
}
