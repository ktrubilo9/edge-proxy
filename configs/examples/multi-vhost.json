{
  "server": {
    "proxy_port": 8080,
    "admin_grpc_port": 50051
  },
  "load_balancing": {
    "strategy": "least-connections"
  },
  "backends": [
    { "id": "frontend-1", "url": "http://frontend-1:8080", "weight": 1, "enabled": true },
    { "id": "frontend-2", "url": "http://frontend-2:8080", "weight": 1, "enabled": true },
    { "id": "api-1", "url": "http://api-1:8080", "weight": 2, "enabled": true },
    { "id": "api-2", "url": "http://api-2:8080", "weight": 2, "enabled": true },
    { "id": "admin-1", "url": "http://admin-1:8080", "weight": 1, "enabled": true }
  ],
  "health_check": {
    "enabled": true,
    "probe": {
      "type": "http",
      "path": "/health",
      "method": "GET",
      "timeout_ms": 1000,
      "success_codes": [200]
    },
    "schedule": {
      "interval_ms": 2000,
      "jitter_ms": 300
    },
    "concurrency": {
      "workers": 8,
      "queue_size": 32
    },
    "thresholds": {
      "healthy": 1,
      "unhealthy": 3
    },
    "recovery": {
      "backoff": {
        "enabled": true,
        "initial_ms": 5000,
        "max_ms": 30000,
        "multiplier": 2.0
      }
    },
    "transport": {
      "max_idle_conns": 100,
      "max_idle_conns_per_host": 4,
      "max_conns_per_host": 16,
      "keep_alive_ms": 30000
    },
    "passive": {
      "enabled": true
    }
  },
  "timeouts": {
    "connect_timeout_ms": 5000,
    "response_timeout_ms": 30000,
    "keep_alive_timeout_ms": 30000,
    "idle_conn_timeout_ms": 90000
  },
  "security": {
    "policies": [
      {
        "id": "public",
        "rate_limiting": {
          "enabled": false,
          "rate_per_ip": 100,
          "burst": 50,
          "window_sec": 60
        }
      },
      {
        "id": "api",
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 60,
          "burst": 20,
          "window_sec": 60
        }
      },
      {
        "id": "admin",
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 20,
          "burst": 10,
          "window_sec": 60
        }
      }
    ]
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "async": true,
    "buffer_size": 65536
  },
  "virtual_hosts": [
    {
      "domain": "app.example.local",
      "backend_ids": ["frontend-1", "frontend-2"],
      "security_policy_id": "public"
    },
    {
      "domain": "api.example.local",
      "backend_ids": ["api-1", "api-2"],
      "security_policy_id": "api"
    },
    {
      "domain": "admin.example.local",
      "backend_ids": ["admin-1"],
      "security_policy_id": "admin"
    }
  ]
}
