{
  "proxy_port": 8080,
  "lb_strategy": "least-connections",
  "backends": [
    { "url": "env:APP_FRONTEND_1_URL", "weight": 1, "enabled": true },
    { "url": "env:APP_FRONTEND_2_URL", "weight": 1, "enabled": true },
    { "url": "env:APP_API_1_URL", "weight": 2, "enabled": true },
    { "url": "env:APP_API_2_URL", "weight": 2, "enabled": true },
    { "url": "env:APP_ADMIN_1_URL", "weight": 1, "enabled": true }
  ],
  "health_check": {
    "path": "/health",
    "interval_seconds": 2,
    "timeout_seconds": 1,
    "healthy_threshold": 1,
    "success_codes": [200]
  },
  "timeouts": {
    "connect_timeout_ms": 5000,
    "response_timeout_ms": 30000,
    "keep_alive_timeout_ms": 30000,
    "idle_conn_timeout_ms": 90000
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "async": true,
    "buffer_size": 65536
  },
  "virtual_hosts": [
    {
      "domain": "app.example.local",
      "backends": ["env:APP_FRONTEND_1_URL", "env:APP_FRONTEND_2_URL"],
      "security": {
        "rate_limiting": {
          "enabled": false,
          "rate_per_ip": 100,
          "burst": 50,
          "window_sec": 60
        }
      }
    },
    {
      "domain": "api.example.local",
      "backends": ["env:APP_API_1_URL", "env:APP_API_2_URL"],
      "security": {
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 60,
          "burst": 20,
          "window_sec": 60
        }
      }
    },
    {
      "domain": "admin.example.local",
      "backends": ["env:APP_ADMIN_1_URL"],
      "security": {
        "rate_limiting": {
          "enabled": true,
          "rate_per_ip": 20,
          "burst": 10,
          "window_sec": 60
        }
      }
    }
  ]
}
