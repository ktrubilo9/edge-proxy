{
  "server": {
    "proxy_port": 8080,
    "admin_grpc_port": 50051
  },
  "load_balancing": {
    "strategy": "least-connections"
  },
  "backends": [
    { "id": "backend-1", "url": "env:BACKEND1_URL", "weight": 1, "enabled": true },
    { "id": "backend-2", "url": "env:BACKEND2_URL", "weight": 1, "enabled": true }
  ],
  "health_check": {
    "enabled": true,
    "probe": {
      "type": "http",
      "path": "/health",
      "method": "GET",
      "timeout_ms": 1000,
      "success_codes": [200]
    },
    "schedule": {
      "interval_ms": 2000,
      "jitter_ms": 500
    },
    "concurrency": {
      "workers": 16,
      "queue_size": 64
    },
    "thresholds": {
      "healthy": 1,
      "unhealthy": 3
    },
    "recovery": {
      "backoff": {
        "enabled": false,
        "initial_ms": 5000,
        "max_ms": 30000,
        "multiplier": 2.0
      }
    },
    "transport": {
      "max_idle_conns": 100,
      "max_idle_conns_per_host": 4,
      "max_conns_per_host": 16,
      "keep_alive_ms": 30000
    },
    "passive": {
      "enabled": false
    }
  },
  "timeouts": {
    "connect_timeout_ms": 30000,
    "response_timeout_ms": 30000,
    "keep_alive_timeout_ms": 30000,
    "idle_conn_timeout_ms": 90000
  },
  "security": {
    "policies": [
      {
        "id": "default",
        "rate_limiting": {
          "enabled": false,
          "rate_per_ip": 100,
          "burst": 50,
          "window_sec": 60
        }
      }
    ]
  },
  "logging": {
    "enabled": true,
    "level": "error",
    "async": true,
    "buffer_size": 65536
  },
  "virtual_hosts": [
    {
      "domain": "app.example.local",
      "backend_ids": ["backend-1", "backend-2"],
      "security_policy_id": "default"
    }
  ]
}
