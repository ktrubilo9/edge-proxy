{
    "proxy_port": 8080,
    "lb_strategy": "least-connections",
    "backends": [
        { "url": "env:BACKEND1_URL", "weight": 1, "enabled": true },
        { "url": "env:BACKEND2_URL", "weight": 1, "enabled": true }
    ],
    "health_check": {
        "path": "/health",
        "interval_seconds": 2,
        "timeout_seconds": 1,
        "healthy_threshold": 1,
        "success_codes": [200]
    },
    "timeouts": {
        "connect_timeout_ms": 30000,
        "response_timeout_ms": 30000,
        "keep_alive_timeout_ms": 30000,
        "idle_conn_timeout_ms": 90000
    },
    "logging": {
        "enabled": true,
        "level": "error",
        "async": true,
        "buffer_size": 65536
    },
    "virtual_hosts": [
        {
            "domain": "app.example.local",
            "backends": ["env:BACKEND1_URL", "env:BACKEND2_URL"],
            "security": {
                "rate_limiting": {
                    "enabled": false,
                    "rate_per_ip": 100,
                    "burst": 50,
                    "window_sec": 60
                }
            }
        }
    ]
}
