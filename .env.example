# Local-only Grafana password used by docker-compose.
GF_PASSWORD=change-me-before-sharing

# Optional local CORS override for the admin API when testing a browser UI.
# ADMIN_ALLOWED_ORIGIN=http://localhost:3000

ADMIN_AUTH_ENABLED=true
ADMIN_API_TOKEN=change-me

# Shared secret used only between admin-api and the proxy gRPC control plane.
ADMIN_GRPC_TOKEN=change-me-too

# Only trust forwarding headers from explicitly listed reverse proxies.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16

# Operational endpoints bind to loopback by default outside Docker.
# OPS_ADDR=127.0.0.1:9091
